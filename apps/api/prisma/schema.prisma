generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// 1. TENANCY, IDENTITY & RBAC
// ==============================================================================

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Organization {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String                  @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  memberships          Membership[]
  roles                Role[]
  warehouses           Warehouse[]
  products             Product[]
  inventoryBalances    InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements   InventoryMovement[]

  settings             OrganizationSettings?
  orders               Order[]
  shipments            Shipment[]
  returns              Return[]
  deliveryPartners     DeliveryPartner[]
  pricingRules         PricingRule[]
  shippingQuotes       ShippingQuote[]
  invoices             Invoice[]
  creditNotes          CreditNote[]
  refunds              Refund[]
  partnerPayables      PartnerPayable[]
  financialEntries     FinancialEntry[]
  fulfillmentWorkflows FulfillmentWorkflow[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
}

model OrganizationSettings {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @unique @db.Uuid
  defaultCurrency        String       @default("USD")
  operatingTimezone      String       @default("UTC")
  autoAllocationEnabled  Boolean      @default(true)
  reorderAlertThreshold  Int          @default(10)
  distanceWeight         Decimal      @default(0.40) @db.Decimal(5, 2)
  costWeight             Decimal      @default(0.40) @db.Decimal(5, 2)
  splitWeight            Decimal      @default(0.20) @db.Decimal(5, 2)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id])
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id])
  memberships    MembershipRole[]

  @@unique([organizationId, name])
}

model MembershipRole {
  membershipId String     @db.Uuid
  roleId       String     @db.Uuid

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

// ==============================================================================
// 2. WAREHOUSES & STORAGE LOCATIONS
// ==============================================================================

model Warehouse {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @db.Uuid
  name                  String
  code                  String
  address               String?
  city                  String?
  country               String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id])
  locations             StorageLocation[]
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  shipments             Shipment[]
  returns               Return[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StorageLocation {
  id                    String                 @id @default(uuid()) @db.Uuid
  warehouseId           String                 @db.Uuid
  name                  String
  code                  String
  type                  String                 @default("BIN")
  createdAt             DateTime               @default(now())

  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

// ==============================================================================
// 3. PRODUCTS & INVENTORY LEDGER
// ==============================================================================

model Product {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @db.Uuid
  name                  String
  sku                   String
  description           String?
  category              String?                @default("General")
  unit                  String                 @default("UNIT")
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id])
  inventoryBalances     InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  orderItems            OrderItem[]
  shipmentItems         ShipmentItem[]
  returnItems           ReturnItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  IN_TRANSIT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum MovementType {
  RECEIVE
  RESERVE
  RELEASE
  PICK
  PACK
  DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RECONCILIATION
  RESTOCK
}

model InventoryBalance {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  warehouseId    String          @db.Uuid
  locationId     String          @db.Uuid
  productId      String          @db.Uuid

  availableQty   Int             @default(0)
  reservedQty    Int             @default(0)
  damagedQty     Int             @default(0)
  inTransitQty   Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([warehouseId, locationId, productId])
  @@index([organizationId, productId])
  @@index([warehouseId])

  organization   Organization    @relation(fields: [organizationId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  location       StorageLocation @relation(fields: [locationId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  warehouseId    String            @db.Uuid
  locationId     String            @db.Uuid
  productId      String            @db.Uuid

  referenceType  String
  referenceId    String            @db.Uuid
  quantity       Int
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, referenceType, referenceId])
  @@index([warehouseId, productId, status])

  organization   Organization      @relation(fields: [organizationId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  location       StorageLocation   @relation(fields: [locationId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
}

model InventoryMovement {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  warehouseId    String          @db.Uuid
  locationId     String          @db.Uuid
  productId      String          @db.Uuid

  movementType   MovementType
  quantity       Int
  referenceType  String?
  referenceId    String?         @db.Uuid
  idempotencyKey String          @unique
  notes          String?
  createdAt      DateTime        @default(now())

  @@index([organizationId, productId, createdAt])
  @@index([warehouseId, createdAt])

  organization   Organization    @relation(fields: [organizationId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  location       StorageLocation @relation(fields: [locationId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
}

// ==============================================================================
// 4. ORDER MANAGEMENT
// ==============================================================================

enum OrderStatus {
  CREATED
  CONFIRMED
  ALLOCATING_INVENTORY
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
  FAILED
}

model Order {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @db.Uuid
  orderNumber        String
  customerId         String
  customerName       String?
  customerEmail      String?
  status             OrderStatus           @default(CREATED)
  shippingCity       String
  shippingPostalCode String
  shippingAddress    String?
  shippingCountry    String?               @default("US")
  totalAmount        Decimal               @default(0) @db.Decimal(12, 2)
  currency           String                @default("USD")
  idempotencyKey     String?               @unique
  allocationScore    Decimal?              @db.Decimal(8, 4)
  notes              String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id])
  items              OrderItem[]
  shipments          Shipment[]
  returns            Return[]
  workflows          FulfillmentWorkflow[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([customerId])
}

model OrderItem {
  id                String       @id @default(uuid()) @db.Uuid
  orderId           String       @db.Uuid
  productId         String       @db.Uuid
  quantity          Int
  fulfilledQuantity Int          @default(0)
  unitPrice         Decimal      @default(0) @db.Decimal(10, 2)

  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product      @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ==============================================================================
// 5. CARRIER NETWORK & VEHICLES
// ==============================================================================

enum PartnerType {
  DEDICATED
  CARRIER_3PL
  FREIGHT_FORWARDER
  LAST_MILE_COURIER
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ONBOARDING
}

model DeliveryPartner {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  name               String
  code               String
  partnerType        PartnerType      @default(CARRIER_3PL)
  contactEmail       String
  contactPhone       String?
  serviceableRegions String[]
  maxActiveShipments Int              @default(50)
  status             PartnerStatus    @default(ACTIVE)
  onTimeRate         Decimal          @default(98.50) @db.Decimal(5, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id])
  vehicles           Vehicle[]
  shipments          Shipment[]
  payables           PartnerPayable[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

enum VehicleType {
  TRAILER_53FT
  FLATBED
  VAN
  BOX_TRUCK
  SPRINTER
  CONTAINER_40FT
  REEFER
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  OFF_DUTY
}

model Vehicle {
  id                  String               @id @default(uuid()) @db.Uuid
  deliveryPartnerId   String               @db.Uuid
  vehicleNumber       String
  vehicleType         VehicleType
  maxWeightCapacityKg Decimal              @db.Decimal(10, 2)
  maxVolumeCubicMeters Decimal?            @db.Decimal(10, 2)
  status              VehicleStatus        @default(AVAILABLE)
  currentLocation     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  partner             DeliveryPartner      @relation(fields: [deliveryPartnerId], references: [id])
  assignments         ShipmentAssignment[]

  @@index([deliveryPartnerId])
}

// ==============================================================================
// 6. SHIPMENTS, TRACKING & DISPATCH
// ==============================================================================

enum ShipmentStatus {
  CREATED
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_INITIATED
  RETURN_IN_TRANSIT
  RETURNED
  CANCELLED
}

model Shipment {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  orderId              String               @db.Uuid
  warehouseId          String               @db.Uuid
  deliveryPartnerId    String?              @db.Uuid
  trackingNumber       String
  status               ShipmentStatus       @default(CREATED)
  originCity           String
  destinationCity      String
  destinationAddress   String?
  destinationPostalCode String?
  totalWeightKg        Decimal              @default(1.00) @db.Decimal(8, 2)
  packageCount         Int                  @default(1)
  proofOfDeliveryUrl   String?
  failureReason        String?
  rescheduledDate      DateTime?
  estimatedDeliveryDate DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id])
  order                Order                @relation(fields: [orderId], references: [id])
  warehouse            Warehouse            @relation(fields: [warehouseId], references: [id])
  deliveryPartner      DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id])
  items                ShipmentItem[]
  trackingEvents       TrackingEvent[]
  assignments          ShipmentAssignment[]
  invoices             Invoice[]

  @@unique([organizationId, trackingNumber])
  @@index([organizationId, status])
  @@index([orderId])
  @@index([warehouseId])
}

model ShipmentItem {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  productId  String   @db.Uuid
  quantity   Int

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([shipmentId])
}

model TrackingEvent {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @db.Uuid
  eventType  ShipmentStatus
  location   String
  notes      String?
  source     String         @default("system")
  timestamp  DateTime       @default(now())

  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, timestamp])
}

model ShipmentAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  shipmentId   String    @db.Uuid
  vehicleId    String?   @db.Uuid
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?

  shipment     Shipment  @relation(fields: [shipmentId], references: [id])
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([shipmentId])
  @@index([vehicleId])
}

// ==============================================================================
// 7. REVERSE LOGISTICS & RETURNS
// ==============================================================================

enum ReturnStatus {
  REQUESTED
  AUTHORIZED
  IN_TRANSIT
  INSPECTED
  RESTOCKED
  REJECTED
  CLOSED
}

enum RestockDecision {
  RESTOCK_AVAILABLE
  QUARANTINE_DAMAGED
  SCRAP
  VENDOR_CLAIM
}

model Return {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  orderId          String           @db.Uuid
  warehouseId      String           @db.Uuid
  returnNumber     String
  status           ReturnStatus     @default(REQUESTED)
  reason           String
  restockDecision  RestockDecision?
  refundAmount     Decimal?         @db.Decimal(10, 2)
  discrepancyNotes String?
  inspectedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id])
  order            Order            @relation(fields: [orderId], references: [id])
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  items            ReturnItem[]
  refunds          Refund[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, status])
}

model ReturnItem {
  id               String   @id @default(uuid()) @db.Uuid
  returnId         String   @db.Uuid
  productId        String   @db.Uuid
  expectedQuantity Int
  receivedQuantity Int      @default(0)
  damagedQuantity  Int      @default(0)
  isRestocked      Boolean  @default(false)

  return           Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id])

  @@index([returnId])
}

// ==============================================================================
// 8. PRICING ENGINE & TARIFFS
// ==============================================================================

enum PricingServiceType {
  STANDARD_ROAD
  EXPRESS_AIR
  OCEAN_FREIGHT
  INTERMODAL
}

model PricingRule {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  ruleName         String
  serviceType      PricingServiceType @default(STANDARD_ROAD)
  baseCharge       Decimal            @default(80.00) @db.Decimal(10, 2)
  perKmRate        Decimal            @default(1.20) @db.Decimal(6, 2)
  perKgRate        Decimal            @default(0.50) @db.Decimal(6, 2)
  fuelSurchargePct Decimal            @default(15.00) @db.Decimal(5, 2)
  handlingFee      Decimal            @default(10.00) @db.Decimal(8, 2)
  insurancePct     Decimal            @default(2.00) @db.Decimal(5, 2)
  version          Int                @default(1)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id])
  quotes           ShippingQuote[]

  @@unique([organizationId, ruleName, version])
  @@index([organizationId, isActive])
}

model ShippingQuote {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  pricingRuleId   String?            @db.Uuid
  quoteNumber     String
  origin          String
  destination     String
  weightKg        Decimal            @db.Decimal(8, 2)
  distanceKm      Decimal            @db.Decimal(8, 2)
  serviceType     PricingServiceType
  baseCharge      Decimal            @db.Decimal(10, 2)
  distanceCharge  Decimal            @db.Decimal(10, 2)
  weightCharge    Decimal            @db.Decimal(10, 2)
  fuelSurcharge   Decimal            @db.Decimal(10, 2)
  handlingFee     Decimal            @db.Decimal(10, 2)
  insuranceCharge Decimal            @db.Decimal(10, 2)
  discount        Decimal            @default(0) @db.Decimal(10, 2)
  totalCharge     Decimal            @db.Decimal(10, 2)
  expiresAt       DateTime
  createdAt       DateTime           @default(now())

  organization    Organization       @relation(fields: [organizationId], references: [id])
  pricingRule     PricingRule?       @relation(fields: [pricingRuleId], references: [id])

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, expiresAt])
}

// ==============================================================================
// 9. FINANCE, INVOICES & 3-WAY RECONCILIATION
// ==============================================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  shipmentId       String?          @db.Uuid
  invoiceNumber    String
  status           InvoiceStatus    @default(ISSUED)
  subtotal         Decimal          @db.Decimal(12, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal          @db.Decimal(12, 2)
  currency         String           @default("USD")
  dueDate          DateTime
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id])
  shipment         Shipment?        @relation(fields: [shipmentId], references: [id])
  financialEntries FinancialEntry[]
  creditNotes      CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
}

model CreditNote {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  invoiceId        String       @db.Uuid
  creditNoteNumber String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id])
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, creditNoteNumber])
  @@index([invoiceId])
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  SETTLED
  REJECTED
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  returnId       String?      @db.Uuid
  refundNumber   String
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("USD")
  status         RefundStatus @default(PENDING)
  reason         String
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  return         Return?      @relation(fields: [returnId], references: [id])

  @@unique([organizationId, refundNumber])
  @@index([organizationId, status])
}

model PartnerPayable {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  deliveryPartnerId String          @db.Uuid
  payableNumber     String
  amount            Decimal         @db.Decimal(10, 2)
  status            String          @default("PENDING")
  dueDate           DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  organization      Organization    @relation(fields: [organizationId], references: [id])
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])

  @@unique([organizationId, payableNumber])
  @@index([organizationId, status])
}

enum EntryType {
  DEBIT
  CREDIT
}

model FinancialEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  invoiceId      String?      @db.Uuid
  entryType      EntryType
  account        String
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId, account])
}

// ==============================================================================
// 10. DISTRIBUTED WORKFLOWS & SAGAS
// ==============================================================================

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  COMPENSATING
  COMPENSATED
}

model FulfillmentWorkflow {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  orderId        String            @db.Uuid
  workflowType   String            @default("ORDER_FULFILLMENT")
  status         WorkflowStatus    @default(PENDING)
  currentStep    String?
  retryCount     Int               @default(0)
  maxRetries     Int               @default(3)
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id])
  order          Order             @relation(fields: [orderId], references: [id])
  steps          FulfillmentStep[]

  @@index([organizationId, status])
  @@index([orderId])
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  COMPENSATED
}

model FulfillmentStep {
  id          String              @id @default(uuid()) @db.Uuid
  workflowId  String              @db.Uuid
  stepName    String
  stepOrder   Int
  status      StepStatus          @default(PENDING)
  payload     Json?
  result      Json?
  error       String?
  executedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workflow    FulfillmentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, stepOrder])
}

// ==============================================================================
// 11. TRANSACTIONAL OUTBOX & EVENT DEDUPLICATION
// ==============================================================================

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
}

model ProcessedEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @unique
  consumerGroup String
  processedAt   DateTime @default(now())

  @@index([eventId, consumerGroup])
}

// ==============================================================================
// 12. SECURITY: API KEYS & FORENSIC AUDIT LOGS
// ==============================================================================

model ApiKey {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  keyName         String
  keyPrefix       String
  hashedKey       String
  scopes          String[]
  rateLimitPerMin Int          @default(600)
  expiresAt       DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, keyName])
  @@index([hashedKey])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?
  actorEmail     String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  timestamp      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, action, timestamp])
  @@index([resourceType, resourceId])
}
