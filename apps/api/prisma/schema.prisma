generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  roles       Role[]
  warehouses  Warehouse[]
  products    Product[]
  inventoryBalances InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements InventoryMovement[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id])
  memberships    MembershipRole[]

  @@unique([organizationId, name])
}

model MembershipRole {
  membershipId String     @db.Uuid
  roleId       String     @db.Uuid

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model Warehouse {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  code           String
  address        String?
  city           String?
  country        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  locations      StorageLocation[]
  inventoryBalances InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StorageLocation {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @db.Uuid
  name        String
  code        String
  createdAt   DateTime  @default(now())

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  inventoryBalances InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements InventoryMovement[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  sku            String
  description    String?
  unit           String       @default("UNIT")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  inventoryBalances InventoryBalance[]
  inventoryReservations InventoryReservation[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  IN_TRANSIT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum MovementType {
  RECEIVE
  RESERVE
  RELEASE
  PICK
  PACK
  DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RECONCILIATION
}

model InventoryBalance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  warehouseId    String   @db.Uuid
  locationId     String   @db.Uuid
  productId      String   @db.Uuid

  availableQty   Int      @default(0)
  reservedQty    Int      @default(0)
  damagedQty     Int      @default(0)
  inTransitQty   Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([warehouseId, locationId, productId])
  @@index([organizationId, productId])
  @@index([warehouseId])

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location StorageLocation @relation(fields: [locationId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  warehouseId    String            @db.Uuid
  locationId     String            @db.Uuid
  productId      String            @db.Uuid

  referenceType  String
  referenceId    String            @db.Uuid
  quantity       Int
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, referenceType, referenceId])
  @@index([warehouseId, productId, status])

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location StorageLocation @relation(fields: [locationId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  warehouseId    String       @db.Uuid
  locationId     String       @db.Uuid
  productId      String       @db.Uuid

  movementType   MovementType
  quantity       Int
  referenceType  String?
  referenceId    String?      @db.Uuid
  idempotencyKey String       @unique
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, productId, createdAt])
  @@index([warehouseId, createdAt])

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location StorageLocation @relation(fields: [locationId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
