# ==============================================================================
# FleetFlow - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_USER=fleetflow
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=fleetflow
POSTGRES_PORT=5433

# Connection URL used by the NestJS API and Prisma
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# --- Authentication & JWT ---
JWT_SECRET=replace_with_secure_jwt_secret
JWT_EXPIRES_IN=7d

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# --- Redpanda (Kafka-compatible) ---
REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_SCHEMA_REGISTRY_PORT=8081
REDPANDA_CONSOLE_PORT=8080

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=fleetflow_minio
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# --- NestJS API ---
API_PORT=3001

# --- NestJS Worker ---
WORKER_PORT=3002

# --- Frontend ---
WEB_PORT=5173

